# Backend
# Default: local SQLite for friction-free dev.
# Override with PostgreSQL in Docker / production:
#   DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/dclaw_project
DATABASE_URL=sqlite+aiosqlite:///./dclaw_project.db
APP_ENV=dev
DEBUG=true

# AI Copilot (Complexity 1)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Auth
# In production this MUST be overridden — the app refuses to boot when
# APP_ENV=production and SECRET_KEY is still the default below.
# Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS — comma-separated origins permitted to call the API with
# credentials. The wildcard `*` is disallowed together with credentials
# (per the CORS spec).
CORS_ALLOW_ORIGINS=http://localhost:3010,http://localhost:3000

# Document upload (C2 6.9)
DCLAW_DOCS_DIR=./uploads
DCLAW_DOC_MAX_BYTES=10485760  # 10 MiB

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8100
